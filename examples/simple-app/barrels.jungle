# Download tinymetrix-latest-debug.barrel from
# https://github.com/tinymetrix/client/releases/latest and save it to
# output/tinymetrix-latest-debug.barrel (relative to the repo root) — this
# path then works with no editing. Using a pinned version instead? Point
# this at wherever you saved it.
Tinymetrix = "../../output/tinymetrix-latest-debug.barrel"
base.barrelPath = $(base.barrelPath);$(Tinymetrix)
